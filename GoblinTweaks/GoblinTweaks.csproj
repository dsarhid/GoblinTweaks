<!--
  The Dalamud.NET.Sdk version is the Dalamud API level.
  Change it ONLY when Dalamud releases a new API level (see docs/MAINTENANCE.md).
-->
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.14</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Dalamud plugin manifest. Shown in the in-game plugin installer. -->
  <PropertyGroup>
    <Author>David Sarhid</Author>
    <Name>GoblinTweaks</Name>
    <Punchline>Quality-of-life crafting tweaks for FFXIV.</Punchline>
    <Description>A collection of crafting quality-of-life tweaks, including a Crafting Materials window that cross-references every recipe against your bags, saddlebag, retainers and FC chest and shows what you can make right now.</Description>
    <Tags>crafting;inventory;quality-of-life</Tags>
    <RepoUrl>https://github.com/dsarhid/GoblinTweaks</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/dsarhid/GoblinTweaks/main/GoblinTweaks/Assets/Icon.png</IconUrl>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" />
    <EmbeddedResource Include="Assets\Icon.png" />
    <!-- Icon shown by Dalamud for dev builds -->
    <None Include="Assets\Icon.png" Link="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="KamiToolKit" Version="2.2.38" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- KamiToolKit loads the textures of its color picker from an Assets folder next to the plugin. -->
  <ItemGroup>
    <None Include="$(PkgKamiToolKit)\content\Assets\*.png" Link="Assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
